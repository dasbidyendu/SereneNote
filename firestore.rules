rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can only read and write their own profile
      allow read, write: if isOwner(userId);
    }
    
    // JournalEntries collection
    match /journalEntries/{journalId} {
      // Any authenticated user can create a journal entry.
      // The user must be the author of the document.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      
      // Only the author can read, update, or delete their own entries
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.authorId);
    }

    // Allow signed-in users to list public journal entries
    match /journalEntries/{journalId} {
        allow list: if isSignedIn() && resource.data.isPublic == true;
    }
  }
}
