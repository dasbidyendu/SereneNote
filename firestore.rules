rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can only read, create, and update their own profile.
      allow read, write: if isOwner(userId);
    }
    
    // JournalEntries collection
    match /journalEntries/{journalId} {
      // Any authenticated user can create a journal entry, as long as they are the author.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      
      // Public entries can be read by any signed-in user.
      // Private entries can only be read by their owner.
      allow read: if isSignedIn() && (resource.data.isPublic == true || isOwner(resource.data.authorId));

      // Only the author can update or delete their own entries.
      allow update, delete: if isSignedIn() && isOwner(resource.data.authorId);
    }

    // This rule is necessary to allow collection-level queries, like fetching all public journals.
    match /journalEntries/{document=**} {
        allow list: if isSignedIn();
    }
  }
}
