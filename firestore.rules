
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      
      // Allow a user to update their own profile.
      // Also allow any user to update another user's 'followers' array, but only to add/remove their own uid.
      allow update: if isSignedIn() && (
        isOwner(userId) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']) &&
          (
            request.resource.data.followers.size() == resource.data.followers.size() + 1 && request.auth.uid in request.resource.data.followers
          ) ||
          (
            request.resource.data.followers.size() == resource.data.followers.size() - 1 && !(request.auth.uid in resource.data.followers)
          )
        )
      );

      allow delete: if isOwner(userId);
    }
    
    // This rule is necessary to allow collection-level queries.
    match /users/{document=**} {
        allow list: if isSignedIn();
    }
    
    // JournalEntries collection
    match /journalEntries/{journalId} {
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      
      allow read: if isSignedIn() && (resource.data.isPublic == true || isOwner(resource.data.authorId));

      allow delete: if isSignedIn() && isOwner(resource.data.authorId);
      
      // Simplified update rule: allow any signed-in user to update.
      // This will allow liking and read counts to be updated by anyone.
      // Authors can still update their own posts.
      allow update: if isSignedIn();
    }

    // This rule is necessary to allow collection-level queries, like fetching all public journals.
    match /journalEntries/{document=**} {
        allow list: if isSignedIn();
    }
  }
}
