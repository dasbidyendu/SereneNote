rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can only read and write their own profile
      allow read, write: if isOwner(userId);
    }
    
    // JournalEntries collection
    match /journalEntries/{journalId} {
      // Any authenticated user can create a journal entry, as long as they are the author.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      
      // Only the author can read, update, or delete their own entries.
      // Anyone can read public entries.
      allow read, update, delete: if isSignedIn() && (isOwner(resource.data.authorId) || resource.data.isPublic == true);

      // Allow signed-in users to list (query) public journal entries.
      // This rule is for collections.
      allow list: if isSignedIn();
    }
  }
}
