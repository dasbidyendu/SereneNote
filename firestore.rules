
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check if the incoming write is ONLY for likes or reads.
    // It checks that no other fields are being changed.
    function isLikingOrReading() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys;
      let allowedKeys = ['likes', 'likeCount', 'readCount'];
      return changedKeys.hasOnly(allowedKeys) || 
             (changedKeys.hasAll(allowedKeys) && changedKeys.size() <= allowedKeys.size());
    }

    // A simpler check for when an author is updating their own post.
    // We just need to make sure they are NOT touching the like/read fields.
    function isNotLikingOrReading() {
       let changedKeys = request.resource.data.diff(resource.data).affectedKeys;
       return !changedKeys.hasAny(['likes', 'likeCount', 'readCount']);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }
    
    // This rule is necessary to allow collection-level queries.
    match /users/{document=**} {
        allow list: if isSignedIn();
    }
    
    // JournalEntries collection
    match /journalEntries/{journalId} {
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      
      allow read: if isSignedIn() && (resource.data.isPublic == true || isOwner(resource.data.authorId));

      allow delete: if isSignedIn() && isOwner(resource.data.authorId);
      
      // Allow author to update their own non-like/read fields.
      // Allow any signed-in user to ONLY update likes and read counts.
      allow update: if isSignedIn() && 
                      ( (isOwner(resource.data.authorId) && isNotLikingOrReading()) ||
                        (!isOwner(resource.data.authorId) && isLikingOrReading()) );
    }

    // This rule is necessary to allow collection-level queries, like fetching all public journals.
    match /journalEntries/{document=**} {
        allow list: if isSignedIn();
    }
  }
}
