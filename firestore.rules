
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow users to update their own profile, including the 'following' list.
      allow write: if isOwner(userId);
    }
    
    // JournalEntries collection
    match /journalEntries/{journalId} {
      // Any authenticated user can create a journal entry, as long as they are the author.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      
      // Public entries can be read by any signed-in user.
      // Private entries can only be read by their owner.
      allow read: if isSignedIn() && (resource.data.isPublic == true || isOwner(resource.data.authorId));

      // Allow the author to delete their entry.
      allow delete: if isSignedIn() && isOwner(resource.data.authorId);
      
      // Allow author to update their own entries (except for like/read counts).
      // Allow any signed-in user to update likes and read counts.
      allow update: if isSignedIn() && 
                      (isOwner(resource.data.authorId) && !isChangingLikesOrReads()) ||
                      isLikingOrReading();
    }
    
    // Helper function to check if the update is only for likes or reads
    function isLikingOrReading() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys;
      return changedKeys.hasAny(['likeCount', 'readCount', 'likes']);
    }

    // Helper function to prevent author from modifying their own like/read counts
    function isChangingLikesOrReads() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys;
      return changedKeys.hasAny(['likeCount', 'readCount', 'likes']);
    }

    // This rule is necessary to allow collection-level queries, like fetching all public journals.
    match /journalEntries/{document=**} {
        allow list: if isSignedIn();
    }
  }
}
